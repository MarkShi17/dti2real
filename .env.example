# No variables are required for the complete bundled demo.
# Copy to .env.local. Empty provider names auto-select a configured service.
# DEMO_MODE=true forces every service into demo, even if keys are present.
DEMO_MODE=false
# For Compose port substitution put this in shell/.env, not only .env.local.
DTI2IRL_PORT=3212

# Vision: openai_compatible | openrouter | demo
VISION_PROVIDER=
VISION_MODEL=
VISION_API_KEY=
# Optional compatible API base, e.g. https://openrouter.ai/api/v1
VISION_BASE_URL=
# Optional real image-based reranking using the same vision model.
VISUAL_RERANK=false

# US Google Shopping and optional eBay Browse production access.
SERPAPI_KEY=
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=

# Try-on: fashn_api | fashn_local | demo
TRYON_PROVIDER=
FASHN_API_KEY=
FASHN_LOCAL_URL=
FASHN_LOCAL_TOKEN=

# Poses: fal | demo. POSE_API_KEY is a fal API key.
POSE_PROVIDER=
POSE_MODEL=fal-ai/flux-2/klein/9b/edit
POSE_API_KEY=

# Exact trusted image domains, comma-separated. Subdomains are allowed.
# Built-ins: gstatic.com, googleusercontent.com, ebayimg.com, cdn.fashn.ai,
# fal.media, fashn.ai. Private/reserved IPs and redirects always blocked.
IMAGE_ALLOWED_HOSTS=

# Recommended for deployment behind an HTTPS reverse proxy.
# PUBLIC_ORIGIN=https://your-app.example.com

# Local process only; Docker sets /app/.data and mounts a private volume.
# DATA_DIR=/absolute/private/path/dti2irl-sessions
